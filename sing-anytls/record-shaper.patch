--- pre-rs/session/record_shaper.go	1970-01-01 00:00:00.000000000 +0000
+++ fixed/session/record_shaper.go	2026-03-19 05:20:05.973463545 +0000
@@ -0,0 +1,178 @@
+package session
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"net"
+	"time"
+
+	"github.com/anytls/sing-anytls/padding"
+	"github.com/anytls/sing-anytls/util"
+	"github.com/sagernet/sing/common/atomic"
+)
+
+const (
+	controlFrameThreshold = 21
+	writeDeadline         = 5 * time.Second
+)
+
+type RecordShaper struct {
+	conn      net.Conn
+	LastWrite time.Time
+
+	cfg        padding.RecordShaperConfig
+	paddingSrc *atomic.TypedValue[*padding.PaddingFactory]
+	lastCfgMd5 string
+}
+
+func newRecordShaper(conn net.Conn, paddingSrc *atomic.TypedValue[*padding.PaddingFactory]) *RecordShaper {
+	pf := paddingSrc.Load()
+	return &RecordShaper{
+		conn:       conn,
+		LastWrite:  time.Now(),
+		paddingSrc: paddingSrc,
+		cfg:        pf.RecordConfig,
+		lastCfgMd5: pf.Md5,
+	}
+}
+
+func (rs *RecordShaper) maybeRefreshConfig() {
+	pf := rs.paddingSrc.Load()
+	if pf.Md5 != rs.lastCfgMd5 {
+		rs.cfg = pf.RecordConfig
+		rs.lastCfgMd5 = pf.Md5
+	}
+}
+
+// WriteData sends data-frame bytes to the TLS connection WITHOUT a
+// write deadline, matching the upstream behaviour where data-frame
+// writes never had a timeout.  On a congested mobile link the TCP
+// send buffer may take seconds to drain; a 5-second deadline would
+// kill the session prematurely.
+func (rs *RecordShaper) WriteData(b []byte) (int, error) {
+	total := len(b)
+	_, err := rs.conn.Write(b)
+	if err == nil {
+		rs.LastWrite = time.Now()
+	}
+	return total, err
+}
+
+// WriteControl sends control-frame bytes.  Small frames (≤21 B) are
+// padded with a cmdWaste trailer and written with a 5-second deadline,
+// reproducing the upstream writeControlFrame semantics.
+func (rs *RecordShaper) WriteControl(b []byte) (int, error) {
+	total := len(b)
+	if len(b) <= controlFrameThreshold {
+		b = rs.padControlFrame(b)
+	}
+	rs.conn.SetWriteDeadline(time.Now().Add(writeDeadline))
+	_, err := rs.conn.Write(b)
+	rs.conn.SetWriteDeadline(time.Time{})
+	if err == nil {
+		rs.LastWrite = time.Now()
+	}
+	return total, err
+}
+
+func (rs *RecordShaper) padControlFrame(b []byte) []byte {
+	rs.maybeRefreshConfig()
+	targets := rs.cfg.PadTargets
+	if len(targets) == 0 {
+		return b
+	}
+
+	minTarget := len(b) + headerOverHeadSize
+	var eligible []padding.PadTarget
+	for _, t := range targets {
+		if t.Max >= minTarget {
+			eligible = append(eligible, t)
+		}
+	}
+	if len(eligible) == 0 {
+		return b
+	}
+
+	picked := eligible[cryptoRandIntn(len(eligible))]
+	var target int
+	if picked.Min == picked.Max {
+		target = picked.Min
+	} else {
+		lo := picked.Min
+		if lo < minTarget {
+			lo = minTarget
+		}
+		target = lo + cryptoRandIntn(picked.Max-lo+1)
+	}
+
+	gap := target - len(b)
+	wastePayload := gap - headerOverHeadSize
+	if wastePayload < 0 {
+		wastePayload = 0
+	}
+
+	out := make([]byte, 0, target)
+	out = append(out, b...)
+
+	var hdr [headerOverHeadSize]byte
+	hdr[0] = cmdWaste
+	binary.BigEndian.PutUint32(hdr[1:5], 0)
+	binary.BigEndian.PutUint16(hdr[5:7], uint16(wastePayload))
+	out = append(out, hdr[:]...)
+	if wastePayload > 0 {
+		pad := make([]byte, wastePayload)
+		util.FillRandom(pad)
+		out = append(out, pad...)
+	}
+	return out
+}
+
+// BuildIdleFrame returns a small waste frame, or nil if the connection
+// hasn't been idle long enough.  The caller writes the bytes.
+func (rs *RecordShaper) BuildIdleFrame() []byte {
+	rs.maybeRefreshConfig()
+
+	idleThreshold := time.Duration(rs.cfg.IdleThresholdMs) * time.Millisecond
+	if time.Since(rs.LastWrite) < idleThreshold {
+		return nil
+	}
+
+	sizes := rs.cfg.IdleSizes
+	if len(sizes) == 0 {
+		return nil
+	}
+	size := sizes[cryptoRandIntn(len(sizes))]
+
+	wastePayload := size - headerOverHeadSize
+	if wastePayload < 0 {
+		wastePayload = 0
+	}
+
+	record := make([]byte, headerOverHeadSize+wastePayload)
+	record[0] = cmdWaste
+	binary.BigEndian.PutUint32(record[1:5], 0)
+	binary.BigEndian.PutUint16(record[5:7], uint16(wastePayload))
+	if wastePayload > 0 {
+		util.FillRandom(record[headerOverHeadSize:])
+	}
+	return record
+}
+
+func (rs *RecordShaper) IdleInterval() time.Duration {
+	lo := rs.cfg.IdleIntervalMs[0]
+	hi := rs.cfg.IdleIntervalMs[1]
+	if lo <= 0 || hi <= 0 || lo > hi {
+		return time.Duration(lo) * time.Millisecond
+	}
+	ms := lo + cryptoRandIntn(hi-lo+1)
+	return time.Duration(ms) * time.Millisecond
+}
+
+func cryptoRandIntn(n int) int {
+	if n <= 1 {
+		return 0
+	}
+	var b [4]byte
+	rand.Read(b[:])
+	return int(binary.LittleEndian.Uint32(b[:])) % n
+}
