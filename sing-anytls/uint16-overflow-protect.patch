+	// Chunk oversized payloads to prevent uint16 overflow truncation.
+	// The receiver reassembles per-stream via pipe, so multiple PSH
+	// frames are transparent.
+	for len(data) > 0 {
+		chunk := data
+		if len(chunk) > maxFrameDataLen {
+			chunk = chunk[:maxFrameDataLen]
+		}
+		chunkLen := len(chunk)
+
+		buffer := buf.NewSize(chunkLen + headerOverHeadSize)
+		buffer.WriteByte(cmdPSH)
+		binary.BigEndian.PutUint32(buffer.Extend(4), sid)
+		binary.BigEndian.PutUint16(buffer.Extend(2), uint16(chunkLen))
+		buffer.Write(chunk)
+
+		_, err := s.writeConn(buffer.Bytes(), time.Second*5)
+		buffer.Release()
+		if err != nil {
+			s.Close()
+			return 0, err
+		}
+
+		data = data[chunkLen:]
 	}
 
-	return dataLen, nil
